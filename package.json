{
  "name": "playwright-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
 "scripts": {
  "test": "npx playwright test",

  "test:chrome": "npx playwright test --project=chromium",

  "report:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
  "report:open": "npx serve ./allure-report",

  "test:report": "npm run test && npm run report:generate && npm run report:open",
  "test:report:chrome": "npm run test:chrome && npm run report:generate && npm run report:open"
},

  "keywords": [],
