  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0"
  },
  "dependencies": {
    "dotenv": "^17.0.1"
  }
}
